Subject: chimera: the copy protection and the version line are the release's

Prince of Persia 1.0, 1.1 and 1.3/1.4 each ask the copy protection from
their own manual (other pages, lines, words and letters), and 1.1 and
later put the page first on screen. Under CHIMERA_CORE the four tables
are writable so the core can put the release's in before the game
starts, the question on screen asks the core which order it reads in,
and Ctrl+V shows the release's own line instead of SDLPoP's.

--- a/src/data.h
+++ b/src/data.h
@@ -76,7 +76,14 @@
 // data:3D16
 extern word copyprot_idx;
 // data:01CA
-extern const char copyprot_letter[] INIT(= {'A','A','B','B','C','C','D','D','E','F','F','G','H','H','I','I','J','J','K','L','L','M','M','N','O','O','P','P','R','R','S','S','T','T','U','U','V','Y','W','Y'});
+#ifdef CHIMERA_CORE
+// A Chimera core puts the release's tables here before the game starts: each
+// release's manual asks other questions (1.0, 1.1, and 1.3/1.4 differ).
+#define COPYPROT_TABLE
+#else
+#define COPYPROT_TABLE const
+#endif
+extern COPYPROT_TABLE char copyprot_letter[] INIT(= {'A','A','B','B','C','C','D','D','E','F','F','G','H','H','I','I','J','J','K','L','L','M','M','N','O','O','P','P','R','R','S','S','T','T','U','U','V','Y','W','Y'});
 // data:4620
 extern word cplevel_entr[14];
 #endif
--- a/src/seg000.c
+++ b/src/seg000.c
@@ -664,8 +664,13 @@
 		break;
 		case SDL_SCANCODE_V | WITH_CTRL: // Ctrl+V
 			//answer_text = "PRINCE OF PERSIA  V1.0";
+#ifdef CHIMERA_CORE
+			// the release's own line, as its PRINCE.EXE has it
+			answer_text = chimera_version_text();
+#else
 			snprintf(sprintf_temp, sizeof(sprintf_temp), "SDLPoP v%s\n", SDLPOP_VERSION);
 			answer_text = sprintf_temp;
+#endif
 			need_show_text = 1;
 		break;
 		case SDL_SCANCODE_C | WITH_CTRL: // Ctrl+C
@@ -2333,11 +2338,11 @@
 
