{
  "coreName": "SDLPoP",
  "kind": "game",
  "systemNames": {
    "PrinceOfPersia": "Prince of Persia"
  },
  "machineSetting": "version",
  "machines": [
    {
      "id": "PrinceOfPersia",
      "label": "Prince of Persia 1.0 (1990)",
      "when": [
        "1.0"
      ]
    },
    {
      "id": "PrinceOfPersia",
      "label": "Prince of Persia 1.1 (IBM PC)",
      "when": [
        "1.1"
      ]
    },
    {
      "id": "PrinceOfPersia",
      "label": "Prince of Persia 1.3 (1992)",
      "when": [
        "1.3"
      ]
    },
    {
      "id": "PrinceOfPersia",
      "label": "Prince of Persia 1.4 (Collection CD)",
      "when": [
        "1.4"
      ]
    }
  ],
  "author": "David Nagy and the SDLPoP contributors, from Jordan Mechner's Prince of Persia; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-sdlpop",
  "deterministic": true,
  "memoryLayoutMiB": [
    64,
    8,
    8,
    8,
    64
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The game itself is small; the room is for the sounds SDLPoP converts to 44100 Hz stereo when it loads them, SDL's dummy window, and the game's own 4 MiB stack (mmap, MAP_STACK).",
  "video": {
    "_comment": "The DOS game's 320x200 VGA screen, shown on a 4:3 monitor.",
    "width": 320,
    "height": 200,
    "virtualWidth": 320,
    "virtualHeight": 240,
    "vsyncNumerator": 12,
    "vsyncDenominator": 1,
    "_vsync_note": "A frame is one step of the game (docs/game-cores.md): a tick of play is 1/12 s walking and 1/10 s fighting; the title, the cutscenes and the pauses poll the controls every 1/60 s; a room change adds a 1/10 s step with the screen dark. GetVsyncNumerator/Denominator report the step just run; 12/1 is the rate of play.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "SDLPoP's mixer, pulled at 44100 Hz stereo for exactly the time each step covers: 3675 pairs for a tick of play, 735 for a 1/60 s step.",
    "rate": 44100,
    "samplesPerFrame": 44100,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "Prince of Persia",
    "_comment": "The DOS game's keyboard: the arrows, Shift (grab, pick up, strike) and Enter (restart after dying, as Shift does); the game's commands, each its own button (Pause is Esc, Show Time is Space, Restart Level is Ctrl+A, Restart Game Ctrl+R, Next Level Shift+L, Sound On/Off Ctrl+S, Version Ctrl+V); and the cheats the game has when started with its cheat word, active only with the cheats setting on (Show Rooms C, Show Corner Rooms Shift+C, Less Time and More Time keypad - and +, Revive R, Kill Guard K, Flip Screen Shift+I, Feather Fall Shift+W, Look Left/Right/Up/Down H/J/U/N, Look Back Ctrl+B, Blind Mode Shift+B, Add Hit Point Shift+S, Add Max Hit Point Shift+T). Left out: Ctrl+Q (it ends the program), the game's saved games (Ctrl+G and Ctrl+L), and Joystick Mode and Keyboard Mode (Ctrl+J, Ctrl+K), which mean nothing to a movie. The hall of fame's name is the player_name setting, entered by itself.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Shift",
      "P1 Enter",
      "Pause",
      "Show Time",
      "Restart Level",
      "Restart Game",
      "Next Level",
      "Sound On/Off",
      "Version",
      "Cheat Show Rooms",
      "Cheat Show Corner Rooms",
      "Cheat Less Time",
      "Cheat More Time",
      "Cheat Revive",
      "Cheat Kill Guard",
      "Cheat Flip Screen",
      "Cheat Feather Fall",
      "Cheat Look Left",
      "Cheat Look Right",
      "Cheat Look Up",
      "Cheat Look Down",
      "Cheat Look Back",
      "Cheat Blind Mode",
      "Cheat Add Hit Point",
      "Cheat Add Max Hit Point"
    ],
    "mnemonics": {
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "Shift": "^",
      "Enter": "e",
      "Pause": "p",
      "Show Time": "t",
      "Restart Level": "a",
      "Restart Game": "r",
      "Next Level": "n",
      "Sound On/Off": "s",
      "Version": "v",
      "Cheat Show Rooms": "C",
      "Cheat Show Corner Rooms": "Q",
      "Cheat Less Time": "-",
      "Cheat More Time": "+",
      "Cheat Revive": "V",
      "Cheat Kill Guard": "K",
      "Cheat Flip Screen": "I",
      "Cheat Feather Fall": "W",
      "Cheat Look Left": "4",
      "Cheat Look Right": "6",
      "Cheat Look Up": "8",
      "Cheat Look Down": "2",
      "Cheat Look Back": "5",
      "Cheat Blind Mode": "B",
      "Cheat Add Hit Point": "H",
      "Cheat Add Max Hit Point": "M"
    }
  },
  "settings": [
    {
      "name": "version",
      "display": "Version",
      "type": "enum",
      "options": [
        "1.0",
        "1.1",
        "1.3",
        "1.4"
      ],
      "default": "1.0",
      "description": "The release of Prince of Persia played, whose files the project brings. 1.0 (1990) and 1.1 (the IBM PC release) share their data files; 1.3 (1992) and 1.4 (the Prince of Persia Collection CD) share theirs, with 1.3's level colours (level 3's dungeon green, not blue) and two sounds and the music changed. The guards fight by 1.0's tables in 1.0 and by the later ones in 1.1, 1.3 and 1.4; the copy protection asks from each release's own manual (1.0, 1.1, and 1.3/1.4). Each release's PRINCE.EXE is checked too, as it is what tells the two of a pair apart."
    },
    {
      "name": "cheats",
      "display": "Enable Cheats",
      "type": "bool",
      "default": false,
      "description": "Start the game with its cheat word, as the DOS game was started from the command line (megahit; 1.3 and 1.4 used improved). The cheats' buttons exist only with this on. It also lets Next Level (Shift+L) skip any level without cutting the time to 15 minutes."
    },
    {
      "name": "player_name",
      "display": "Player Name (Hall of Fame)",
      "type": "string",
      "default": "Chimera",
      "description": "The name a won game enters in the hall of fame, when its time earns a place there - as the player would have typed it (the printable characters, as many as the box holds, up to 24). There are no letter keys: the game enters it by itself."
    },
    {
      "name": "sound",
      "display": "Sound card",
      "type": "enum",
      "options": [
        "digital",
        "pcSpeaker"
      ],
      "default": "digital",
      "description": "digital: the Sound Blaster's digitized effects and the AdLib music, as SDLPoP plays them. pcSpeaker: the PC speaker's sounds. The game waits for some sounds to end (a level's closing music, the title), so the sound card is part of the machine; digital needs the DIGISND and MIDISND files."
    },
    {
      "name": "random_seed",
      "display": "Random seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "The seed of the game's random number generator at power-on (the DOS game took it from the clock). A movie records the number it ran with."
    },
    {
      "name": "enable_copyprot",
      "display": "Copy protection",
      "type": "bool",
      "default": true,
      "description": "The original game's copy protection: after level 1 comes the potions level, where the prince must drink the potion whose letter the manual gives. On in 1.0; SDLPoP turns it off by default."
    },
    {
      "name": "first_level",
      "display": "First level",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 14,
      "description": "The level a new game starts on (1 in the original game)."
    },
    {
      "name": "skip_title",
      "display": "Skip the title",
      "type": "bool",
      "default": false,
      "description": "Start the first level at once instead of playing the title sequence."
    },
    {
      "name": "start_minutes_left",
      "display": "Minutes",
      "type": "int",
      "default": 60,
      "min": -1,
      "max": 32767,
      "description": "Minutes on the clock at the start (60 in the original game). -1 is no time limit."
    },
    {
      "name": "start_hitp",
      "display": "Hit points",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 10,
      "description": "Hit points at the start of the game (3 in the original game)."
    },
    {
      "name": "max_hitp_allowed",
      "display": "Most hit points",
      "type": "int",
      "default": 10,
      "min": 1,
      "max": 10,
      "description": "The most hit points the prince can reach with life potions (10 in the original game)."
    },
    {
      "name": "use_fixes_and_enhancements",
      "display": "Fixes and enhancements",
      "type": "bool",
      "default": false,
      "description": "SDLPoP's fixes for the original game's bugs and its gameplay enhancements. Off is the original game; on applies the ones below that are turned on (all are off by default)."
    },
    {
      "name": "enable_crouch_after_climbing",
      "display": "Crouch after climbing",
      "type": "bool",
      "default": false,
      "description": "Pressing down and forward together right after climbing up crouches (the original always climbs back down)."
    },
    {
      "name": "enable_freeze_time_during_end_music",
      "display": "Freeze time during the end music",
      "type": "bool",
      "default": false,
      "description": "The clock stops while a level's ending music plays (in the original it keeps running)."
    },
    {
      "name": "enable_remember_guard_hp",
      "display": "Remember guard hit points",
      "type": "bool",
      "default": false,
      "description": "A guard keeps the hit points he had when the prince comes back into his room."
    },
    {
      "name": "enable_super_high_jump",
      "display": "Super high jump",
      "type": "bool",
      "default": false,
      "description": "In feather fall (after the green potion) the prince can jump two stories up."
    },
    {
      "name": "enable_jump_grab",
      "display": "Jump grab",
      "type": "bool",
      "default": false,
      "description": "The prince can grab the floor above while jumping (Shift and Up without forward)."
    },
    {
      "name": "fix_gate_sounds",
      "display": "Fix: gate sounds",
      "type": "bool",
      "default": false,
      "description": "If a room is linked to itself on the left, the closing sounds of its gates can be heard."
    },
    {
      "name": "fix_two_coll_bug",
      "display": "Fix: two collision bug",
      "type": "bool",
      "default": false,
      "description": "An open gate or chomper no longer lets the prince go through walls (tricks 7, 37, 62)."
    },
    {
      "name": "fix_infinite_down_bug",
      "display": "Fix: infinite fall",
      "type": "bool",
      "default": false,
      "description": "A room linked to itself at the bottom, with no floor in the prince's column, no longer hangs the game."
    },
    {
      "name": "fix_gate_drawing_bug",
      "display": "Fix: gate under a gate",
      "type": "bool",
      "default": false,
      "description": "The top of a gate under another gate is drawn."
    },
    {
      "name": "fix_bigpillar_climb",
      "display": "Fix: big pillar climb",
      "type": "bool",
      "default": false,
      "description": "Climbing up to a floor with a big pillar top behind, turned right, no longer sees through the floor."
    },
    {
      "name": "fix_jump_distance_at_edge",
      "display": "Fix: jump distance at an edge",
      "type": "bool",
      "default": false,
      "description": "Climbing up two floors, turning and jumping up no longer makes the prince fall (trick 25 no longer needed)."
    },
    {
      "name": "fix_edge_distance_check_when_climbing",
      "display": "Fix: edge check when climbing",
      "type": "bool",
      "default": false,
      "description": "Climbing to a higher floor no longer checks the edge below, which could teleport the prince."
    },
    {
      "name": "fix_painless_fall_on_guard",
      "display": "Fix: painless fall on a guard",
      "type": "bool",
      "default": false,
      "description": "Falling from a great height onto a guard hurts."
    },
    {
      "name": "fix_wall_bump_triggers_tile_below",
      "display": "Fix: wall bump drops the tile below",
      "type": "bool",
      "default": false,
      "description": "Bumping against a wall no longer drops a loose floor below (tricks 18, 34)."
    },
    {
      "name": "fix_stand_on_thin_air",
      "display": "Fix: standing on thin air",
      "type": "bool",
      "default": false,
      "description": "Standing up from a crouch on a falling loose tile no longer stands on thin air."
    },
    {
      "name": "fix_press_through_closed_gates",
      "display": "Fix: buttons through closed gates",
      "type": "bool",
      "default": false,
      "description": "Buttons right of a closed gate can no longer be pressed through it (trick 1)."
    },
    {
      "name": "fix_grab_falling_speed",
      "display": "Fix: grab two stories down",
      "type": "bool",
      "default": false,
      "description": "Jumping and bumping into a wall no longer grabs a ledge two stories down."
    },
    {
      "name": "fix_skeleton_chomper_blood",
      "display": "Fix: skeleton blood",
      "type": "bool",
      "default": false,
      "description": "A chomper that chomps a skeleton does not become bloody."
    },
    {
      "name": "fix_move_after_drink",
      "display": "Fix: move after drinking",
      "type": "bool",
      "default": false,
      "description": "The controls are released properly after drinking a potion."
    },
    {
      "name": "fix_loose_left_of_potion",
      "display": "Fix: loose floor left of a potion",
      "type": "bool",
      "default": false,
      "description": "Drawing of a loose floor to the left of a potion or sword."
    },
    {
      "name": "fix_guard_following_through_closed_gates",
      "display": "Fix: guards through closed gates",
      "type": "bool",
      "default": false,
      "description": "Guards no longer follow the prince to the next room through a closed gate."
    },
    {
      "name": "fix_safe_landing_on_spikes",
      "display": "Fix: safe landing on spikes",
      "type": "bool",
      "default": false,
      "description": "Landing on the edge of a spikes tile is no longer safe (trick 65)."
    },
    {
      "name": "fix_glide_through_wall",
      "display": "Fix: glide through walls",
      "type": "bool",
      "default": false,
      "description": "Turning around while running no longer glides through walls."
    },
    {
      "name": "fix_drop_through_tapestry",
      "display": "Fix: drop through a tapestry",
      "type": "bool",
      "default": false,
      "description": "The prince can no longer drop through a closed gate with a tapestry above it."
    },
    {
      "name": "fix_land_against_gate_or_tapestry",
      "display": "Fix: land against a gate",
      "type": "bool",
      "default": false,
      "description": "Landing against a closed gate or a tapestry plays the whole landing animation."
    },
    {
      "name": "fix_unintended_sword_strike",
      "display": "Fix: unintended sword strike",
      "type": "bool",
      "default": false,
      "description": "Drawing the sword no longer sometimes strikes at once."
    },
    {
      "name": "fix_retreat_without_leaving_room",
      "display": "Fix: retreat out of a room",
      "type": "bool",
      "default": false,
      "description": "Retreating in a sword fight can no longer leave a room without the room changing (trick 35)."
    },
    {
      "name": "fix_running_jump_through_tapestry",
      "display": "Fix: running jump through a tapestry",
      "type": "bool",
      "default": false,
      "description": "A running jump to the left no longer goes through a tapestry with a floor above."
    },
    {
      "name": "fix_push_guard_into_wall",
      "display": "Fix: guards pushed into walls",
      "type": "bool",
      "default": false,
      "description": "Guards can no longer be pushed into walls."
    },
    {
      "name": "fix_jump_through_wall_above_gate",
      "display": "Fix: jump through a wall above a gate",
      "type": "bool",
      "default": false,
      "description": "A running jump into a wall no longer falls behind a closed gate two floors down (the level 7 skip)."
    },
    {
      "name": "fix_chompers_not_starting",
      "display": "Fix: chompers not starting",
      "type": "bool",
      "default": false,
      "description": "Grabbing a ledge a floor or more down starts the chompers on that row."
    },
    {
      "name": "fix_feather_interrupted_by_leveldoor",
      "display": "Fix: feather fall and the level door",
      "type": "bool",
      "default": false,
      "description": "A level door finishing opening no longer ends feather fall."
    },
    {
      "name": "fix_offscreen_guards_disappearing",
      "display": "Fix: offscreen guards disappearing",
      "type": "bool",
      "default": false,
      "description": "Guards pushed offscreen reappear in the next room."
    },
    {
      "name": "fix_move_after_sheathe",
      "display": "Fix: move after sheathing",
      "type": "bool",
      "default": false,
      "description": "Releasing down while putting the sword away no longer ducks."
    },
    {
      "name": "fix_hidden_floors_during_flashing",
      "display": "Fix: hidden floors while flashing",
      "type": "bool",
      "default": false,
      "description": "After uniting with the shadow on level 12 the hidden floors appear at once."
    },
    {
      "name": "fix_hang_on_teleport",
      "display": "Fix: hang-on teleport",
      "type": "bool",
      "default": false,
      "description": "Grabbing a ledge at a bottom corner of a room no longer teleports to the room above."
    },
    {
      "name": "fix_exit_door",
      "display": "Fix: closed exit doors",
      "type": "bool",
      "default": false,
      "description": "Closed exit doors can no longer be entered after meeting the shadow, after Jaffar dies, or after opening another exit."
    },
    {
      "name": "fix_quicksave_during_feather",
      "display": "Fix: feather fall timing",
      "type": "bool",
      "default": false,
      "description": "Feather fall keeps its length when the game switches between the walking and fighting speeds."
    },
    {
      "name": "fix_caped_prince_sliding_through_gate",
      "display": "Fix: sliding through a gate",
      "type": "bool",
      "default": false,
      "description": "Crouching with the back to a closed gate at a room's left edge no longer slides through it."
    },
    {
      "name": "fix_doortop_disabling_guard",
      "display": "Fix: guards on a door top",
      "type": "bool",
      "default": false,
      "description": "A guard or prince standing on a door top no longer makes guards inactive."
    },
    {
      "name": "fix_jumping_over_guard",
      "display": "Fix: jumping over a guard",
      "type": "bool",
      "default": false,
      "description": "A timed running jump no longer jumps over a guard."
    },
    {
      "name": "fix_falling_through_floor_during_sword_strike",
      "display": "Fix: falling during a strike",
      "type": "bool",
      "default": false,
      "description": "The prince or a guard no longer falls through the floor during a sword strike."
    },
    {
      "name": "fix_register_quick_input",
      "display": "Fix: quick key presses",
      "type": "bool",
      "default": false,
      "description": "A key pressed and released between two ticks still counts."
    },
    {
      "name": "fix_turn_running_near_wall",
      "display": "Fix: turning to run near a wall",
      "type": "bool",
      "default": false,
      "description": "Turning to run right next to a wall, gate or tapestry safe-steps as facing it would (tricks 1 and 2)."
    },
    {
      "name": "fix_feather_fall_affects_guards",
      "display": "Fix: feather fall and guards",
      "type": "bool",
      "default": false,
      "description": "Feather fall affects only the prince, not the guards."
    },
    {
      "name": "fix_one_hp_stops_blinking",
      "display": "Fix: last hit point blinking",
      "type": "bool",
      "default": false,
      "description": "A single hit point keeps blinking after Jaffar is defeated."
    },
    {
      "name": "fix_dead_floating_in_air",
      "display": "Fix: bodies in the air",
      "type": "bool",
      "default": false,
      "description": "A body on a loose floor that drops falls with it."
    }
  ],
  "firmware": [
    {
      "id": "PRINCE.DAT",
      "display": "Prince of Persia 1.0/1.1 PRINCE.DAT",
      "description": "PRINCE.DAT of the original Prince of Persia 1.0/1.1 (DOS): the pictures every level shares (the sword, the flames, the potions) and the palettes (1.3 and 1.4's also hold the level colours). Yours to supply - the package carries none of the game's data. A file of your own (a modified one) may take its place: the project pins its hash.",
      "size": 3278,
      "sha1": "A0CD3C9699ACF510A2EBE2D0D675B837D2CE73C8",
      "name": "PRINCE.DAT",
      "requiredWhen": {
        "setting": "version",
        "in": [
          "1.0",
          "1.1"
        ]
      }
    },
    {
      "id": "PRINCE.DAT",
      "display": "Prince of Persia 1.3/1.4 PRINCE.DAT",
      "description": "PRINCE.DAT of the original Prince of Persia 1.3/1.4 (DOS): the pictures every level shares (the sword, the flames, the potions) and the palettes (1.3 and 1.4's also hold the level colours). Yours to supply - the package carries none of the game's data. A file of your own (a modified one) may take its place: the project pins its hash.",
      "size": 25600,
      "sha1": "57FEDE2FBF1BB4A211066393353B6A2E0060B9BD",
      "name": "PRINCE.DAT",
      "requiredWhen": {
        "setting": "version",
        "in": [
          "1.3",
          "1.4"
        ]
      }
    },
    {
      "id": "KID.DAT",
      "display": "Prince of Persia 1.0/1.1/1.3/1.4 KID.DAT",
      "description": "KID.DAT of the original Prince of Persia 1.0/1.1/1.3/1.4 (DOS): the prince. Yours to supply - the package carries none of the game's data. A file of your own (a modified one) may take its place: the project pins its hash.",
      "size": 37149,
      "sha1": "C7E841443C247BF65FF94C13A4B01FDACA767DCA",
      "name": "KID.DAT",
      "requiredWhen": {
        "setting": "version",
        "in": [
          "1.0",
          "1.1",
          "1.3",
          "1.4"
        ]
      }
    },
    {
      "id": "LEVELS.DAT",
      "display": "Prince of Persia 1.0/1.1/1.3/1.4 LEVELS.DAT",
      "description": "LEVELS.DAT of the original Prince of Persia 1.0/1.1/1.3/1.4 (DOS): the fifteen levels: every room's tiles, the doors, the guards. Yours to supply - the package carries none of the game's data. A file of your own (a modified one) may take its place: the project pins its hash. Not needed when the project brings a level set of its own.",
      "size": 37031,
      "sha1": "2CD58BB1EECE062EF98FD8411377B58F3C72C031",
      "name": "LEVELS.DAT",
      "requiredWhen": {
        "all": [
          {
            "setting": "version",
            "in": [
              "1.0",
              "1.1",
              "1.3",
              "1.4"
            ]
          },
          {
            "not": {
              "slot": "levels"
            }
          }
        ]
      }
    },
    {
      "id": "TITLE.DAT",
      "display": "Prince of Persia 1.0/1.1 TITLE.DAT",
      "description": "TITLE.DAT of the original Prince of Persia 1.0/1.1 (DOS): the title screens, the story pages and the hall of fame. Yours to supply - the package carries none of the game's data. A file of your own (a modified one) may take its place: the project pins its hash.",
      "size": 36725,
      "sha1": "0923E93BCC06C2E0802A4B853E1544EE7E5BB83E",
      "name": "TITLE.DAT",
      "requiredWhen": {
        "setting": "version",
        "in": [
          "1.0",
          "1.1"
